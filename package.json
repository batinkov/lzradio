{
  "name": "lzradio",
  "private": true,
  "version": "0.6.0",
  "maintainer": {
    "callsign": "LZ3DY",
    "github": "batinkov/lzradio"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:repeat": "playwright test --repeat-each=30 --retries=0",
    "verify": "npm run lint && npm run build && npm run test && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "fuse.js": "^7.5.0",
    "katex": "^0.18.7",
    "svelte-i18n": "^4.0.1",
    "svelte-spa-router": "^5.1.1"
  }
}

  "suffixes": [
    { "letter": "A", "meaning": "Auroral distortion" },
    { "letter": "C", "meaning": "Chirp" },
    { "letter": "D", "meaning": "Drift" },
    { "letter": "K", "meaning": "Key clicks" },
    { "letter": "M", "meaning": "Multipath distortion" },
    { "letter": "S", "meaning": "Scatter distortion" },
    { "letter": "X", "meaning": "Stable, crystal-controlled tone" }

      "name": "Readability",
      "values": [
        { "value": 1, "label": "Unreadable" },
        { "value": 2, "label": "Barely readable, a word now and then" },
        { "value": 3, "label": "Readable with considerable difficulty" },
        { "value": 4, "label": "Readable with hardly any difficulty" },
        { "value": 5, "label": "Perfectly readable" }
      ]
    },
    {
      "id": "s",
      "name": "Strength",
      "values": [
        { "value": 1, "label": "Faint, barely perceptible" },
        { "value": 2, "label": "Very weak" },
        { "value": 3, "label": "Weak" },
        { "value": 4, "label": "Fair" },
        { "value": 5, "label": "Fairly good" },
        { "value": 6, "label": "Good" },
        { "value": 7, "label": "Moderately strong" },
        { "value": 8, "label": "Strong" },
        { "value": 9, "label": "Very strong" }
      ]
    },
    {
      "id": "t",
      "name": "Tone",
      "note": "Morse and digital only. Modern equipment almost always earns a 9.",
      "values": [
        { "value": 1, "label": "Very rough, like raw AC hum" },
        { "value": 2, "label": "Very rough AC, harsh and broad" },
        { "value": 3, "label": "Rough AC, rectified but not filtered" },
        { "value": 4, "label": "Rough, with some filtering" },
        { "value": 5, "label": "Filtered, but strongly ripple-modulated" },
        { "value": 6, "label": "Filtered, with a clear trace of ripple" },
        { "value": 7, "label": "Near pure, with a trace of ripple" },
        { "value": 8, "label": "Near perfect, with a slight trace of modulation" },
        { "value": 9, "label": "Perfect, pure tone" }
      ]
    }
